# Minha Cabeleira — Supabase
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Projetos antigos também podem usar:
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Nunca coloque service_role / secret key em VITE_* ou no navegador.

# ----------------------------------------------------------
# Publicação / SEO
# ----------------------------------------------------------
# URL final sem barra no fim. Ex.: https://minhacabeleira.com.br
VITE_SITE_URL=

# E-mail público para dúvidas de privacidade.
VITE_PRIVACY_CONTACT_EMAIL=contato@minhacabeleira.com.br

# ----------------------------------------------------------
# Google Analytics 4
# ----------------------------------------------------------
# Ex.: G-XXXXXXXXXX
# A tag só é carregada após consentimento da visitante.
VITE_GA_MEASUREMENT_ID=

# ----------------------------------------------------------
# Google AdSense — deixe DESATIVADO até a conta/site estarem prontos.
# ----------------------------------------------------------
VITE_ADSENSE_ENABLED=false

# Apenas para visualizar os espaços de anúncio no ambiente local.
# Não carrega anúncios reais.
VITE_ADSENSE_PREVIEW=false

# Ex.: ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# IDs numéricos dos blocos manuais criados no AdSense.
VITE_ADSENSE_SLOT_HOME_CONTENT=
VITE_ADSENSE_SLOT_GLOSSARY_LIST=
VITE_ADSENSE_SLOT_GLOSSARY_ENTRY=
VITE_ADSENSE_SLOT_ABOUT_CONTENT=