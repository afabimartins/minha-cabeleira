# Minha Cabeleira — Supabase
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Projetos antigos também podem usar:
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Nunca coloque service_role / secret key em VITE_* ou no navegador.
